APP_DIR	Makefile	/^APP_DIR = .\/app $/;"	m
CC	app/Makefile	/^CC := arm-linux-gnueabihf-gcc$/;"	m
CUR_DIR	drv/Makefile	/^CUR_DIR := $(shell pwd)$/;"	m
DRV_DIR	Makefile	/^DRV_DIR = .\/drv$/;"	m
DST	app/Makefile	/^DST := app $/;"	m
DST	drv/Makefile	/^DST :=led_drv$/;"	m
IO_DATA	drv/led_drv.c	32;"	d	file:
IO_DIR	drv/led_drv.c	33;"	d	file:
IO_MUX	drv/led_drv.c	30;"	d	file:
IO_PAD	drv/led_drv.c	31;"	d	file:
KER_DIR	drv/Makefile	/^KER_DIR := \/home\/linux\/imx6ull\/linux-imx-rel_imx_4.1.15_2.1.0_ga_alientek$/;"	m
SRC	app/Makefile	/^SRC := app.c $/;"	m
__this_module	drv/led_drv.mod.c	/^__visible struct module __this_module$/;"	v	typeref:struct:module
__used	drv/led_drv.mod.c	/^__used$/;"	v	file:
__used	drv/led_drv.mod.c	/^__used$/;"	v	typeref:struct:____versions	file:
cdev	drv/led_drv.c	/^static struct cdev cdev;$/;"	v	typeref:struct:cdev	file:
dev_no	drv/led_drv.c	/^static dev_t dev_no;  \/\/ 主设备号(12bit)+次设备号(20bit)  32bit  ，$/;"	v	file:
fops	drv/led_drv.c	/^static struct file_operations fops = {$/;"	v	typeref:struct:file_operations	file:
io_data	drv/led_drv.c	/^static volatile void *io_data = NULL;$/;"	v	file:
io_dir	drv/led_drv.c	/^static volatile void *io_dir = NULL;$/;"	v	file:
io_mux	drv/led_drv.c	/^static volatile void *io_mux = NULL;$/;"	v	file:
io_pad	drv/led_drv.c	/^static volatile void *io_pad = NULL;$/;"	v	file:
led_exit	drv/led_drv.c	/^module_exit(led_exit);$/;"	v
led_exit	drv/led_drv.c	/^static void __exit led_exit(void)$/;"	f	file:
led_init	drv/led_drv.c	/^module_init(led_init);$/;"	v
led_init	drv/led_drv.c	/^static int __init led_init(void)$/;"	f	file:
main	app/app.c	/^int main(int argc, char **argv)$/;"	f
myopen	drv/led_drv.c	/^static int myopen(struct inode *node, struct file *f)$/;"	f	file:
myread	drv/led_drv.c	/^static ssize_t myread(struct file *f, char __user *data, size_t size, loff_t *off)$/;"	f	file:
myrelease	drv/led_drv.c	/^static int myrelease(struct inode *node, struct file *f)$/;"	f	file:
mywrite	drv/led_drv.c	/^static ssize_t mywrite(struct file *f, const char __user *data, size_t size, loff_t *off)$/;"	f	file:
