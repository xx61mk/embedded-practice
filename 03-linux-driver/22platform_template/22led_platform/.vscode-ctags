APP_DIR	Makefile	/^APP_DIR = .\/app $/;"	m
CC	app/Makefile	/^CC := arm-linux-gnueabihf-gcc$/;"	m
CUR_DIR	drv/Makefile	/^CUR_DIR := $(shell pwd)$/;"	m
DRV_DIR	Makefile	/^DRV_DIR = .\/drv$/;"	m
DST	app/Makefile	/^DST := app $/;"	m
DST	drv/Makefile	/^DST :=led_drv$/;"	m
KER_DIR	drv/Makefile	/^KER_DIR := \/home\/linux\/imx6ull\/linux-imx-rel_imx_4.1.15_2.1.0_ga_alientek$/;"	m
SRC	app/Makefile	/^SRC := app.c $/;"	m
id_table	drv/led_drv.c	/^struct platform_device_id id_table[]={$/;"	v	typeref:struct:platform_device_id
led_exit	drv/led_drv.c	/^module_exit(led_exit);$/;"	v
led_exit	drv/led_drv.c	/^static void __exit led_exit(void)$/;"	f	file:
led_init	drv/led_drv.c	/^module_init(led_init);$/;"	v
led_init	drv/led_drv.c	/^static int __init led_init(void)$/;"	f	file:
main	app/app.c	/^int main(int argc, char **argv)$/;"	f
myprobe	drv/led_drv.c	/^static int myprobe(struct platform_device * pdev)$/;"	f	file:
myremove	drv/led_drv.c	/^static int myremove(struct platform_device *pdev)$/;"	f	file:
of_table	drv/led_drv.c	/^struct of_device_id of_table[]={$/;"	v	typeref:struct:of_device_id
plat_drv	drv/led_drv.c	/^static struct platform_driver  plat_drv={$/;"	v	typeref:struct:platform_driver	file:
