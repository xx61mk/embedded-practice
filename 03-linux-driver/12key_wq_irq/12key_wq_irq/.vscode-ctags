myrelease	drv/key_drv.c	/^static int myrelease(struct inode *node, struct file *f)$/;"	f	file:
mywrite	drv/key_drv.c	/^static ssize_t mywrite(struct file *f, const char __user *data, size_t size, loff_t *off)$/;"	f	file:
